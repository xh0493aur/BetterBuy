# 这是模板文件，本身不含任何密钥，可以提交。
# 真要用的时候复制成 .streamlit/secrets.toml（该文件已被 .gitignore 排除），
# 或者直接填到 Streamlit Cloud 的 Settings -> Secrets 里。
#
# 键名必须是平铺的 BETTERBUY_ 前缀（也可写成 [betterbuy] 分表，见 DEPLOY.md）。
# 不填也能跑：适配器会明确显示"未配置凭据"，Steam 与其他功能不受影响。

# 京东联盟 / 京东开放平台
BETTERBUY_JD_APP_KEY = ""
BETTERBUY_JD_APP_SECRET = ""

# 淘宝客（淘宝开放平台）——注意前缀是 TB，不是 TAOBAO
BETTERBUY_TB_APP_KEY = ""
BETTERBUY_TB_APP_SECRET = ""
BETTERBUY_TB_ADZONE_ID = ""

# 拼多多开放平台（多多进宝）
# PID 是推广位 ID，形如 1234567_98765432；关键词搜索要求它已完成授权备案。
BETTERBUY_PDD_CLIENT_ID = ""
BETTERBUY_PDD_CLIENT_SECRET = ""
BETTERBUY_PDD_PID = ""
# 可选：关键词搜索报 50001/60001 时，填入与 pid 一起备案过的自定义参数，
# 直接写 JSON 文本，例如 {"uid":"betterbuy"}；只写一个值会被当成 uid。
# BETTERBUY_PDD_CUSTOM_PARAMETERS = '{"uid":"betterbuy"}'
# 可选：只有需要用户授权的接口才用得上
# BETTERBUY_PDD_ACCESS_TOKEN = ""

# 运行参数（可留空，代码里有默认值）
# BETTERBUY_ZERO_COST = "1"
# BETTERBUY_DAILY_LIMIT_TOTAL = "800"
# BETTERBUY_CACHE_TTL = "3600"
# BETTERBUY_API_TIMEOUT = "15"        # 单次接口超时（秒）
# BETTERBUY_API_MIN_INTERVAL = "0.6"  # 同一平台两次调用的最小间隔（秒）

# ---------------- 公网实例的两项保护（仓库公开时建议都开） ----------------
# 1) 访问口令：设了之后，打开页面必须先输口令，陌生访客用不了你的密钥额度。
#    口令只存在 Secrets 里，不进仓库；不设则不拦截（本地开发默认不设）。
# BETTERBUY_ACCESS_CODE = "自己定一串 8 位以上的口令"

# 2) 公网演示模式：把每日上限压到很低（电商各 20 次、合计 120 次），
#    即使页面被陌生人刷，也只是几十次请求，不花钱、不触发风控。
# BETTERBUY_PUBLIC_DEMO = "1"
